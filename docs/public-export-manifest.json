{
  "schema": 1,
  "include": [
    ".agents/",
    ".claude/",
    ".codex/",
    ".gitattributes",
    ".github/",
    ".gitignore",
    ".greptile/",
    ".no-mistakes.yaml",
    ".tasks.toml",
    "AGENTS.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "GROK_BOT.md",
    "LICENSE",
    "README.md",
    "SUPERVISOR.md",
    "UPGRADING.md",
    "VISION.md",
    "assets/",
    "bin/",
    "distribution/",
    "docs/",
    "locales/",
    "overseer/",
    "skills/",
    "tests/",
    "worker/"
